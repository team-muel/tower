# Unity YAML — 텍스트로 유지, smart merge 대상
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf

# 코드/텍스트
*.cs text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.md text eol=lf

# 바이너리 → Git LFS
